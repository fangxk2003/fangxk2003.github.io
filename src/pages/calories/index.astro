---
import CaloriesApp from '../../components/calories/CaloriesApp';
import CaloriesOfflineShell from '../../components/calories/CaloriesOfflineShell.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Your personal food and calorie journal." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#244a3c" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Calories" />
    <link rel="icon" type="image/svg+xml" href="/calories/icon.svg" />
    <link rel="apple-touch-icon" href="/calories/apple-touch-icon.png" />
    <link rel="manifest" href="/calories/manifest.webmanifest" />
    <title>Calories · Daily journal</title>
  </head>
  <body>
    <CaloriesApp client:load />
    <CaloriesOfflineShell />
    <noscript><p style="padding:2rem;font-family:system-ui">Enable JavaScript to use your private calorie journal.</p></noscript>
  </body>
</html>
<style>body { margin: 0; }</style>
